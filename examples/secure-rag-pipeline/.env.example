# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# StrongDM ID — register at https://id.strongdm.ai
# Run: curl -s -X POST https://id.strongdm.ai/realms/default/register/request \
#        -H 'Content-Type: application/json' \
#        -d '{"email":"you@example.com","client_name":"rag-orchestrator","requested_scopes":["openid"]}'
# Then confirm with the verification code from your email.
SDM_CLIENT_ID=cli_rag_orchestrator_XXXXXXXX
SDM_CLIENT_SECRET=sec_XXXXXXXXXXXXXXXX
SDM_ISSUER=https://id.strongdm.ai/realms/default

# LLM API keys — these stay inside the llm-mcp container only.
# Agents never see these keys; they authenticate via JWT.
ANTHROPIC_API_KEY=sk-ant-XXXXXXXX
OPENAI_API_KEY=sk-XXXXXXXX
